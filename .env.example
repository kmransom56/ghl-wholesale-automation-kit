# GoHighLevel
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_PIPELINE_ID=your_pipeline_id_for_deals

# DealDriven (Playwright scraper — no API key required)
DEALDRIVEN_USERNAME=your_dealdriven_email
DEALDRIVEN_PASSWORD=your_dealdriven_password

# Wholesale rules
WHOLESALE_70_RULE_PERCENTAGE=0.70
WHOLESALE_OFFER_MULTIPLIER=0.95

# Server
SERVER_PORT=5000
FLASK_ENV=production
LOG_LEVEL=INFO

# Feature flags
ENABLE_QUALITY_SCORING=true
ENABLE_PROPERTY_MATCHING=true
DRY_RUN=false
