# GoHighLevel Configuration
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_PIPELINE_ID=your_ghl_pipeline_id_for_deals

# Partner Driven Integration
PARTNER_DRIVEN_API_KEY=your_partner_driven_api_key_here

# DealDriven Integration
DEALDRIVEN_API_KEY=your_dealdriven_api_key_here
DEALDRIVEN_USER_ID=your_dealdriven_user_id

# Wholesale Business Configuration
WHOLESALE_70_RULE_PERCENTAGE=0.70
WHOLESALE_OFFER_MULTIPLIER=0.95
PARTNER_DRIVEN_FEE_THRESHOLD=15000

# Post-Close Services
CREDIT_DAWG_MONTHLY_FEE=49.00
PRIVACY_DAWG_MONTHLY_FEE=19.99

# Outset Solutions Integration
OUTSET_SOLUTIONS_API_KEY=your_outset_api_key

# NetIntegrate Configuration
NETINTEGRATE_API_KEY=your_netintegrate_api_key
NETINTEGRATE_AUTO_ENROLL=false

# Automation Settings
DEBUG_MODE=false
LOG_LEVEL=INFO
AUTO_CONTACT_CREATION=true
AUTO_OPPORTUNITY_CREATION=true
AUTO_DEAL_ROUTING=true
AUTO_PARTNER_DRIVEN_SUBMISSION=true

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password
NOTIFICATION_EMAIL=your_notification_email@example.com
